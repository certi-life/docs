    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "sax": "1.6.1",
    "unified": "11.0.5"
